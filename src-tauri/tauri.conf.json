{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectManager",
  "version": "0.8.4",
  "identifier": "com.root.projectmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectManager",
        "width": 1000,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2MUFBNDJFQjA1NzcwOUQKUldTZGNGZXdMcVFhOWs5UTgzYTZsYkV1Z0I4dWcwRmVoSy9UNXp2VXdQb3d0bDhjRDUxWW55TnIK",
      "endpoints": [
        "https://github.com/AlicDanclic/ProjectManager/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
